<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Core only restores from nuget.org (Microsoft.Extensions.Options + test packages).
    Consumers of StangaNetLib.* should add the GitHub Packages source in their own nuget.config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
